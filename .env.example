# 실제 값은 .env에 넣고, .env는 절대 커밋하지 않습니다.
# 이 파일에는 키 이름과 발급처만 남깁니다.

# 도서관 정보나루 (https://www.data4library.kr)
# 마이페이지 > 인증키 관리에서 서버 IP를 등록해야 1일 한도가 500건에서 30,000건으로 올라갑니다.
D4L_AUTH_KEY=

# 국립중앙도서관 ISBN 서지정보 API (https://www.nl.go.kr/seoji/)
SEOJI_CERT_KEY=

# 공공데이터포털 (https://www.data.go.kr)
# 도서관 정보 제공 서비스, 전국도서관표준데이터에 사용합니다.
DATA_GO_KR_SERVICE_KEY=

# PostgreSQL 접속 정보
DATABASE_URL=

# 원본 아카이브용 오브젝트 스토리지 (S3 호환)
ARCHIVE_ENDPOINT=
ARCHIVE_BUCKET=
ARCHIVE_ACCESS_KEY_ID=
ARCHIVE_SECRET_ACCESS_KEY=
